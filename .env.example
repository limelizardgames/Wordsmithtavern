# Copy to .env.local (git-ignored) and fill in your own AdMob ad unit ids.
# Without these, the app uses Google's test ad units, which is what you want during development.
# App ids (…~…) are NOT set here: they go in android/app/src/main/res/values/strings.xml
# and ios/App/App/Info.plist (GADApplicationIdentifier). See docs/RELEASE.md.

VITE_ADMOB_PRODUCTION=false

VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=

VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=

# Comma-separated device ids that should always get test ads (printed in logcat / Xcode console).
VITE_ADMOB_TEST_DEVICES=

# Show the in-browser pretend ads in a production web build (demos, end-to-end tests).
VITE_MOCK_ADS=false
